<script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "on-surface-variant": "#45464d",
                      "inverse-on-surface": "#eff1f3",
                      "surface-variant": "#e0e3e5",
                      "on-tertiary": "#ffffff",
                      "tertiary-fixed": "#a6f4b5",
                      "on-error": "#ffffff",
                      "on-surface": "#191c1e",
                      "primary": "#000000",
                      "surface-container-lowest": "#ffffff",
                      "error-container": "#ffdad6",
                      "tertiary-container": "#00210b",
                      "on-secondary-fixed-variant": "#005049",
                      "inverse-surface": "#2d3133",
                      "outline-variant": "#c6c6cd",
                      "surface-tint": "#565e74",
                      "on-secondary-container": "#006f66",
                      "on-background": "#191c1e",
                      "on-secondary-fixed": "#00201d",
                      "on-tertiary-container": "#49935c",
                      "primary-fixed": "#dae2fd",
                      "on-primary": "#ffffff",
                      "on-secondary": "#ffffff",
                      "error": "#ba1a1a",
                      "tertiary-fixed-dim": "#8bd79b",
                      "surface-bright": "#f7f9fb",
                      "outline": "#76777d",
                      "on-primary-fixed": "#131b2e",
                      "secondary-container": "#86f2e4",
                      "primary-container": "#131b2e",
                      "on-error-container": "#93000a",
                      "on-primary-fixed-variant": "#3f465c",
                      "on-tertiary-fixed-variant": "#005226",
                      "surface": "#f7f9fb",
                      "secondary-fixed-dim": "#6bd8cb",
                      "tertiary": "#000000",
                      "secondary": "#006a61",
                      "inverse-primary": "#bec6e0",
                      "surface-container-highest": "#e0e3e5",
                      "on-primary-container": "#7c839b",
                      "surface-container-high": "#e6e8ea",
                      "secondary-fixed": "#89f5e7",
                      "primary-fixed-dim": "#bec6e0",
                      "surface-dim": "#d8dadc",
                      "on-tertiary-fixed": "#00210b",
                      "surface-container-low": "#f2f4f6",
                      "surface-container": "#eceef0",
                      "background": "#f7f9fb"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "container-max": "1280px",
                      "gutter": "24px",
                      "unit": "8px",
                      "stack-xs": "4px",
                      "stack-md": "24px",
                      "margin-mobile": "16px",
                      "stack-lg": "48px",
                      "stack-sm": "12px",
                      "margin-desktop": "40px"
              },
              "fontFamily": {
                      "headline-lg": ["Inter"],
                      "body-md": ["Source Sans 3"],
                      "body-lg": ["Source Sans 3"],
                      "headline-md": ["Inter"],
                      "label-caps": ["Inter"],
                      "headline-xl": ["Inter"],
                      "label-sm": ["JetBrains Mono"],
                      "headline-lg-mobile": ["Inter"]
              },
              "fontSize": {
                      "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                      "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                      "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
                      "label-caps": ["12px", {"lineHeight": "16px", "letterSpacing": "0.1em", "fontWeight": "700"}],
                      "headline-xl": ["40px", {"lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                      "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                      "headline-lg-mobile": ["28px", {"lineHeight": "36px", "fontWeight": "600"}]
              }
            },
          },
        }
    </script>
<style>
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(241, 245, 249, 1);
            box-shadow: 0 10px 15px -3px rgba(0, 106, 97, 0.04);
        }
        .text-gradient {
            background: linear-gradient(135deg, #131b2e 0%, #006a61 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .water-flow-pattern {
            background-color: #f7f9fb;
            background-image: radial-gradient(#006a61 0.5px, transparent 0.5px);
            background-size: 24px 24px;
            opacity: 0.1;
        }
        .bg-navy-navy {
            background-color: #0f172a;
        }
    </style>
</head>
<body class="bg-surface font-body-md text-on-surface selection:bg-secondary-container selection:text-on-secondary-container">
<!-- TopNavBar -->
<nav class="fixed top-0 left-0 w-full z-50 bg-surface/80 dark:bg-on-background/80 backdrop-blur-md border-b border-outline-variant/30 shadow-sm px-margin-mobile md:px-margin-desktop py-4">
<div class="max-w-container-max mx-auto flex justify-between items-center h-12">
<div class="flex items-center gap-3">
<img alt="Aqua Weight Logo" class="h-10 w-10 object-contain" src="https://lh3.googleusercontent.com/aida/AP1WRLtnLgqpmsXcbAsEpFXMMoPZ9NAe6jAZRQSID_f9etZIdIue-JPD4jmMEeLh0rNf05y3CKtwgsbjtrn18JZavy_Zvq3ISzvrodrOgGnxo_V4eXncs20Uy4OGlDsWzlPS4L0hW_Td19eq2192_KJBFX0yGg3Uwlv7bXMkkUHJjq4hFjct24Tp5jdZLbaEQ69QB8Z-hIzm70tOUO8tMSXwwk2AEYoCVkqkmyojUgHFOcvs_bKZjcSpoSOC7uTO">
