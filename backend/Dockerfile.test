FROM python:3.11-slim AS runner

# Install Node.js and npm for Vitest
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nodejs \
        npm \
        git \
        curl \
        ca-certificates && \
    npm install -g vitest && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt /tmp/requirements.txt
COPY backend/requirements-tests.txt /tmp/requirements-tests.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    pip install --no-cache-dir -r /tmp/requirements-tests.txt

# Install frontend dependencies (including jsdom, @vitest/coverage-v8 from package.json)
COPY frontend/package.json frontend/package-lock.json /tmp/frontend/
RUN cd /tmp/frontend && npm install --no-audit --no-fund

# Note: Source code is mounted via volume from docker-compose.test.yml
# Default command runs pytest (can be overridden by compose)
CMD ["pytest", "-q"]